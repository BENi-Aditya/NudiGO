# NudiGO environment variables.
# Copy to `.env` and fill in your keys. The app runs fine WITHOUT these
# (curriculum + progress work locally); they enable accounts, cloud sync, and AI features.

# ========================================
# 1. CLAUDE API (for AI chat features)
# ========================================
# If you have a free Claude API key from Anthropic/Agent Router:
# 1. Go to console.anthropic.com (or your provider's console)
# 2. Navigate to API keys section
# 3. Create or copy your API key (starts with sk-ant-...)
# 4. Paste it below in VITE_AI_API_KEY
# 5. Keep VITE_AI_API_PROVIDER as "anthropic"

VITE_AI_API_PROVIDER=anthropic
VITE_AI_API_KEY=sk-ant-your-anthropic-key-here

# (Alternative: if using OpenAI instead, uncomment below and comment above)
# VITE_AI_API_PROVIDER=openai
# VITE_AI_API_KEY=sk-your-openai-key-here

# ========================================
# 2. GOOGLE OAUTH (for Sign in with Google)
# ========================================
# Steps to get Google OAuth credentials:
# 1. Go to Google Cloud Console: https://console.cloud.google.com
# 2. Create a new project (or select existing)
# 3. Enable APIs:
#    - Search for "Google+ API" → Enable it
# 4. Go to "APIs & Services" → "Credentials"
# 5. Click "Create Credentials" → "OAuth 2.0 Client ID"
# 6. Choose "Web application" as application type
# 7. Add Authorized JavaScript origins:
#    - http://localhost:5173 (for local dev)
#    - https://yourdomain.com (for production)
# 8. Add Authorized redirect URIs:
#    - http://localhost:5173/auth/callback
#    - https://yourdomain.com/auth/callback
# 9. Copy the Client ID and Secret below

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret

# ========================================
# 3. SUPABASE (for user accounts & cloud sync)
# ========================================
# Steps to set up Supabase:
# 1. Go to https://supabase.com
# 2. Sign up / log in
# 3. Create a new project (choose a region close to your users)
# 4. Wait for project to initialize (2-3 minutes)
# 5. Go to Project Settings → API
# 6. Find and copy:
#    - Project URL → paste in VITE_SUPABASE_URL
#    - anon public key → paste in VITE_SUPABASE_PUBLISHABLE_KEY
#    - service_role secret key → paste in SUPABASE_SERVICE_ROLE_KEY
# 7. Keep the same values for both client and server config

# Client-side keys (PUBLIC - safe to expose)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server-side keys (PRIVATE - NEVER expose to client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ========================================
# WHERE TO PASTE THIS FILE
# ========================================
# 1. Copy this entire file
# 2. In the project root, create a file named `.env` (note the dot at start)
# 3. Paste the contents
# 4. Replace all "your-*" placeholders with your actual keys
# 5. Save the file
# 6. Restart the dev server: npm run dev

# ========================================
# WHAT EACH KEY DOES
# ========================================
# VITE_AI_API_KEY: Powers the AI chat tutor for roleplay scenarios
# VITE_GOOGLE_CLIENT_ID/SECRET: Enables "Sign in with Google" button
# VITE_SUPABASE_*: Stores user accounts, progress, and syncs across devices
