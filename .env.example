# NudiGO environment variables.
# Copy to `.env` and fill in your keys. The app runs fine WITHOUT these
# (curriculum + progress work locally); they enable accounts, cloud sync, and AI features.

# === SUPABASE (Optional — enables accounts and cloud sync) ===
# Find these in Supabase → Project Settings → API
# Client keys are public and safe to expose.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server-side Supabase keys (never expose to client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === GOOGLE OAUTH (Optional — enables Google Sign-In button) ===
# Get these from Google Cloud Console: APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret

# === AI CONVERSATION API (Optional — enables AI roleplay scenarios) ===
# The AI conversation mode lets learners practice with an AI tutor.
# Supported providers: OpenAI, Anthropic, local API, or custom backend.
# Leave blank to use mock responses in development; the app will still have full lesson functionality.

# OpenAI (if using GPT-4/3.5 for the conversation tutor)
VITE_AI_API_PROVIDER=openai
VITE_AI_API_KEY=sk-your-openai-key
# If using a custom backend proxy instead of direct client calls:
VITE_AI_API_URL=http://localhost:3001/api/conversation

# Anthropic Claude (alternative to OpenAI)
# VITE_AI_API_PROVIDER=anthropic
# VITE_AI_API_KEY=sk-ant-your-anthropic-key
